# Devbox configuration. Copy to devbox/.env and add that path to .gitignore.
#
# This file configures the EDITOR container only. The project's own settings stay in the project's
# own .env - keeping them apart means restarting the editor never touches application config.
#
# There are deliberately no token or API-key variables here. Credentials are created inside the box
# (`gh auth login` and friends), so each one is scoped to the box and revocable without touching
# your host. See references/security.md.

# code-server's login password. Set it. Left empty, code-server generates one into a config file
# inside the container, which you then have to go and find.
DEVBOX_PASSWORD=change-me

# Host-side ports. The inside of the container is fixed; only these change.
DEVBOX_PORT=8443
DEVBOX_SSH_PORT=2222

# Remote-SSH. 1 starts sshd, but only when devbox/ssh/authorized_keys actually holds a key -
# no key means no listening ssh service regardless of this value.
DEVBOX_ENABLE_SSH=1

# Memory ceiling for the box. Build daemons in a container size their heaps against the HOST's
# RAM and get OOM-killed, which surfaces as a compiler crash rather than an out-of-memory error.
DEVBOX_MEM_LIMIT=8g

# Git identity (name and email, not a credential). Mounted read-only so commits made in the box
# are attributed to you rather than to a machine-generated identity.
# Windows and macOS hosts: `~` does not expand the way you expect - give a full path.
#   DEVBOX_GITCONFIG=C:/Users/<you>/.gitconfig
DEVBOX_GITCONFIG=~/.gitconfig

# Linux hosts: set these to `id -u` / `id -g`, or files the box writes into the mounted repo come
# out owned by root.
DEVBOX_UID=1000
DEVBOX_GID=1000

TZ=UTC
